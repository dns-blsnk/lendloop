{
  "name": "lendloop",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint . --max-warnings=0 && turbo run lint:fsd",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm n8n:check",
    "prepare": "husky",
    "n8n:build": "node n8n/src/build.mjs",
    "n8n:check": "node scripts/check-n8n-exports.mjs",
    "n8n:setup": "./scripts/n8n-setup.sh"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@convex-dev/eslint-plugin": "^5.0.1",
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "16.4.6",
    "@types/node": "^24.19.2",
    "eslint": "9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.13",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
