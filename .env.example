# Docker Compose (root .env). Generate each secret with: openssl rand -hex 32

# Convex self-hosted backend
CONVEX_INSTANCE_SECRET=

# n8n: encrypts stored credentials
N8N_ENCRYPTION_KEY=

# HMAC secrets, one per direction. Set the same values in Convex, together with the address
# Convex uses to reach n8n inside the Docker network (not localhost):
#   pnpm --filter @lendloop/backend exec convex env set CONVEX_TO_N8N_SECRET <value>
#   pnpm --filter @lendloop/backend exec convex env set N8N_TO_CONVEX_SECRET <value>
#   pnpm --filter @lendloop/backend exec convex env set N8N_WEBHOOK_BASE_URL http://n8n:5678/webhook
CONVEX_TO_N8N_SECRET=
N8N_TO_CONVEX_SECRET=

# Clerk issuer for Convex (Clerk Dashboard → JWT templates → "convex" → Issuer). Leave empty and
# Convex accepts no tokens at all (every caller is a guest).
CLERK_JWT_ISSUER_DOMAIN=
